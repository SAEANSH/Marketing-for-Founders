# GitHub owner whose repositories this site should publish.
# Works for a user account or an organisation.
GITHUB_OWNER=SAEANSH

# Optional — a classic/fine-grained token with read-only public repo scope.
# Without it you get 60 API requests/hour; with it, 5,000/hour.
# Keep it server-side only. Never commit real values.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# How long (seconds) rendered content stays cached before GitHub is re-read.
GITHUB_REVALIDATE=300

# Brand name shown in the header/title.
NEXT_PUBLIC_SITE_NAME=RepoDocs
